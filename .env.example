# === LabControl Environment Configuration ===
# Copy this file to backend/.env and adjust values for your environment
# For production, use a secure .env file with strong passwords

# Application
APP_NAME=LabControl
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=labcontrol
DB_USERNAME=labcontrol
DB_PASSWORD=labcontrol

# Redis (Cache & Queue)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="labcontrol@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Filesystem
FILESYSTEM_DISK=local
# For production, use S3 compatible storage:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# PWA
VITE_APP_URL=http://localhost

# Backup (optional - for automated backups)
# BACKUP_DB_HOST=postgres
# BACKUP_DB_USER=labcontrol
# BACKUP_DB_NAME=labcontrol
# BACKUP_RETENTION_DAYS=30